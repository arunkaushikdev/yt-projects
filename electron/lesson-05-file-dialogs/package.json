{
  "name": "expense-tracker-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Expense Tracker as a desktop app (Electron course, Lesson 5)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "electron": "^45.5.0",
    "vite": "^8.3.6",
    "wait-on": "^9.0.0"
  }
}
